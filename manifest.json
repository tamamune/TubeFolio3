{
  "manifest_version": 3,
  "name": "TubeFolio3",
  "version": "0.1.0",
  "description": "YouTube動画をフォルダで整理する",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "TubeFolio3 を開く",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "web_accessible_resources": [
    { "resources": ["icons/*.png"], "matches": ["https://www.youtube.com/*"] }
  ],
  "permissions": ["storage", "declarativeNetRequest", "cookies"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
